EWP_USERNAME=your_username_or_email
EWP_PASSWORD=your_password
# ประเภทผู้ใช้งาน: "ผู้กระทำการแทน" / "คนต่างด้าว" / "นายจ้าง-คนไทย" / "นายจ้าง-คนต่างชาติ" / "บริษัทนำเข้า (บนจ.)"
EWP_USER_TYPE=ผู้กระทำการแทน
# วิธีย่อย: "E-Workpermit" หรือ "DOE e-Service"
EWP_LOGIN_METHOD=E-Workpermit
# true = ซ่อนเบราว์เซอร์, false = แสดงเบราว์เซอร์ (แนะนำเมื่อมี reCAPTCHA)
EWP_HEADLESS=false
