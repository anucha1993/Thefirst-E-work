>\n                    </div>\n                    <i class=\"ri-menu-line wrapper-menu\"></i>\n                    <a href=\"index.html\" class=\"header-logo\"></a>\n                </div>\n\n\n\n            </nav>\n        </div>\n        <script src=\"/manage/UserMenuViewComponent.js?app_version=1.0.1271&amp;build_version=1.0.2236-fix-65\"></script>\n\n<style>\n    div.dropdown-item {\n        display: block;\n        width: 100%;\n        padding: 0.25rem 1.5rem;\n        clear: both;\n        font-weight: 400;\n        color: #212529;\n        text-align: inherit;\n        white-space: nowrap;\n        background-color: transparent;\n        border: 0;\n    }\n\n        div.dropdown-item:hover,\n        div.dropdown-item:focus {\n            color: #16181b;\n            text-decoration: none;\n            background-color: #f8f9fa;\n        }\n\n        div.dropdown-item.active,\n        div.dropdown-item:active {\n            color: #212529;\n            text-decoration: none;\n            background-color: #f8f9fa;\n        }\n\n        div.dropdown-item.disabled,\n        div.dropdown-item:disabled {\n            color: #6c757d;\n            pointer-events: none;\n            background-color: transparent;\n        }\n\n    .number_invitation_list {\n        background: #FF6259;\n        color: #FFFFFF;\n        padding: 4px;\n        border-radius: 15px;\n        font-weight: bold;\n        font-size: 10px;\n        margin-left: 5px;\n        width: 26px;\n        height: 24px;\n        text-align: center;\n    }\n\n    .div-border-pink {\n        margin: 15px;\n        border: 1px solid #F6C8D9;\n        border-radius: 8px;\n    }\n\n    .div-border-grey {\n        margin: 15px;\n        border: 1px solid #EAEAED;\n        border-radius: 8px;\n    }\n</style>\n\n<input type=\"hidden\" id=\"humvc_validate_token\" value=\"http://eworkpermit.doe.go.th/Home/ValidateToken\" placeholder=\"กรุณากรอก\">\n<input type=\"hidden\" id=\"humvc_get_profile_datas\" value=